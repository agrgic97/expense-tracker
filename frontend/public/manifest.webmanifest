{
  "name": "Ausgaben-Tracker",
  "short_name": "Ausgaben",
  "description": "Ausgaben und Einnahmen erfassen, Budgets im Blick behalten",
  "lang": "de",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f6fa",
  "theme_color": "#4f46e5",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Neue Ausgabe", "url": "/?new=expense", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Neue Einnahme", "url": "/?new=income", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Buchungen", "url": "/expenses", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
