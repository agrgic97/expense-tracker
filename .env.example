# Kopieren nach .env und anpassen
POSTGRES_DB=expenses
POSTGRES_USER=expenses
POSTGRES_PASSWORD=change-me
APP_PORT=8080
DB_PORT=5432
TZ=Europe/Berlin

# Schlüssel zum Signieren der JWTs (mind. 32 Zeichen), z. B. erzeugt mit: openssl rand -base64 48
# Leer = zufälliger Schlüssel bei jedem Start (alle werden dann beim Neustart abgemeldet)
JWT_SECRET=
# Gültigkeit eines Tokens, z. B. 12h, 7d
JWT_EXPIRATION=7d
# Nach dem Anlegen der eigenen Konten auf false setzen, damit sich niemand Fremdes registriert
REGISTRATION_ENABLED=true
