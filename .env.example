# Kopieren nach .env und anpassen
POSTGRES_DB=expenses
POSTGRES_USER=expenses
POSTGRES_PASSWORD=change-me
APP_PORT=8080
DB_PORT=5432
TZ=Europe/Berlin

# Schlüssel zum Signieren der JWTs (mind. 32 Zeichen), z. B. erzeugt mit: openssl rand -base64 48
# Leer = zufälliger Schlüssel bei jedem Start (alle werden dann beim Neustart abgemeldet)
JWT_SECRET=
# Gültigkeit des Access-Tokens (kurz) und des Refresh-Tokens (Dauer der Anmeldung)
ACCESS_TOKEN_VALIDITY=15m
REFRESH_TOKEN_VALIDITY=30d
# Auf true setzen, sobald die App über HTTPS ausgeliefert wird (Cookies dann nur noch über HTTPS)
COOKIE_SECURE=false
# Nach dem Anlegen der eigenen Konten auf false setzen, damit sich niemand Fremdes registriert
REGISTRATION_ENABLED=true

# Öffentliche Adresse der App, wird für Links in Mails verwendet
APP_BASE_URL=http://localhost:8080

# Mailserver für „Passwort vergessen“ (SMTP mit STARTTLS). Leer = Funktion ausgeblendet
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Absender, Standard ist MAIL_USERNAME
MAIL_FROM=
