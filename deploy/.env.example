# Auf dem Server als /opt/expense-tracker/.env anlegen (chmod 600). Geheimnisse erzeugen mit: openssl rand -base64 48
DOMAIN=deinearmutkotztmichan.com

POSTGRES_DB=expenses
POSTGRES_USER=expenses
POSTGRES_PASSWORD=
JWT_SECRET=

ACCESS_TOKEN_VALIDITY=15m
REFRESH_TOKEN_VALIDITY=30d
# Bleibt aus: Dein Konto kommt mit dem Datenumzug, Fremde sollen sich nicht registrieren können
REGISTRATION_ENABLED=false
TZ=Europe/Berlin
